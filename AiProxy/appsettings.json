{
  "AiProxy": {
    "Host": "127.0.0.1",
    "Port": 3489,
    "TimeoutSeconds": 300,
    "TodoBridgeEnabled": true,
    "M365Copilot": {
      "Enabled": true,
      "EnableInteractiveLogin": false,
      "Locale": "en-GB",
      "TimeZone": "Europe/Oslo",
      "IncludeWorkspaceFiles": true,
      "EnableWorkspaceWrites": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
