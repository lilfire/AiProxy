<!doctype html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · AiProxy</title>
    <style>
        :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; color:#e8edf7; background:#0b1020; }
        * { box-sizing:border-box; } body { margin:0; min-height:100vh; background:radial-gradient(circle at 15% 0,#1d3158 0,transparent 35rem),#0b1020; }
        .shell { width:min(100%,1920px); margin:auto; padding:clamp(16px,1.5vw,28px); } .topbar { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:0 4px 28px; }
        .brand { display:flex; align-items:center; gap:12px; color:#fff; font-weight:750; text-decoration:none; letter-spacing:-.02em; font-size:1.15rem; } .logo { width:36px; height:36px; display:grid; place-items:center; border-radius:10px; background:linear-gradient(135deg,#5f8dff,#8c5bff); box-shadow:0 8px 24px #5f8dff44; }
        .local { color:#9fb1ce; font-size:.84rem; padding:7px 10px; border:1px solid #2b3b5e; border-radius:999px; background:#111a2e; }
        .layout { display:grid; grid-template-columns:218px minmax(0,1fr); gap:clamp(18px,1.6vw,30px); } nav { display:grid; align-content:start; gap:6px; position:sticky; top:20px; }
        nav a { color:#aebbd1; border-radius:9px; padding:11px 13px; text-decoration:none; font-weight:600; } nav a:hover,nav a:focus,nav a.active { background:#1c2d4c; color:#fff; }
        main { min-width:0; } h1 { margin:0; font-size:clamp(1.7rem,3vw,2.25rem); letter-spacing:-.04em; } h2 { font-size:1rem; margin:0; } .eyebrow { color:#82aaff; text-transform:uppercase; letter-spacing:.11em; font-size:.74rem; font-weight:700; margin:0 0 8px; }
        .page-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; margin:4px 0 26px; } .subtitle { color:#aebbd1; margin:8px 0 0; line-height:1.5; }
        .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; } .card, form, table { background:#111a2e; border:1px solid #263755; border-radius:13px; box-shadow:0 16px 38px #0206112b; }
        .card { padding:18px; } .card-head { display:flex; justify-content:space-between; align-items:center; gap:8px; } .meta { color:#aebbd1; margin:14px 0 4px; font-size:.9rem; line-height:1.45; }
        .status { font-size:.76rem; font-weight:750; border-radius:999px; padding:5px 9px; } .status.ok { color:#8ff0bb; background:#123a2d; } .status.bad { color:#ffb0b0; background:#48242d; } .ok { color:#8ff0bb; } .bad { color:#ffb0b0; }
        .card-link { display:inline-block; margin-top:15px; color:#a9c3ff; font-size:.88rem; font-weight:650; text-decoration:none; } .card-link:hover { color:#fff; } .usage { margin-top:16px; padding-top:14px; border-top:1px solid #263755; } .usage .eyebrow { margin-bottom:5px; } .usage p { margin:0; font-size:.88rem; color:#dce7ff; } .usage strong { font-size:1.1rem; } .usage span { color:#aebbd1; } .usage .meta { margin-top:5px; font-size:.8rem; } .meta.compact { margin:0; font-size:.8rem; }
        .summary { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin:0 0 20px; } .summary .card { padding:16px 18px; } .stat { font-size:1.8rem; font-weight:750; letter-spacing:-.04em; margin-top:5px; }
        .dashboard { max-width:1180px; }
        .dashboard-heading { margin-bottom:32px; }
        .dashboard-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; margin:0 0 34px; }
        .summary-card { min-height:156px; padding:22px 24px; }
        .summary-card .meta { margin-top:13px; }
        .summary-card .card-link { margin-top:12px; }
        .section-heading { display:flex; align-items:end; justify-content:space-between; gap:16px; margin:0 0 16px; }
        .section-heading h2 { font-size:1.2rem; letter-spacing:-.02em; }
        .provider-list { display:grid; gap:14px; }
        .provider-card { display:grid; grid-template-columns:minmax(190px,.8fr) minmax(0,2fr) auto; align-items:center; gap:26px; min-width:0; padding:20px 24px; }
        .provider-card h3 { margin:0; font-size:1.06rem; letter-spacing:-.015em; }
        .provider-detail { margin:10px 0 0; }
        .provider-details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; min-width:0; }
        .provider-card .usage { margin:0; padding:0; border:0; }
        .provider-card .usage .eyebrow { margin-bottom:9px; }
        .provider-card .usage p { font-size:.92rem; }
        .provider-card .usage strong { font-size:1rem; }
        .quota-window + .quota-window { margin-top:13px; padding-top:13px; border-top:1px solid #20314e; }
        .provider-card .quota-value { color:#dce7ff; }
        .provider-card .usage .meta { margin-top:5px; line-height:1.5; }
        .provider-card .usage-activity { padding-left:24px; border-left:1px solid #263755; }
        .provider-link { margin:0; white-space:nowrap; }
        form { padding:20px; } table { border-collapse:separate; border-spacing:0; overflow:hidden; } th,td { padding:13px 15px; text-align:left; border-bottom:1px solid #263755; } th { color:#aebbd1; font-size:.77rem; text-transform:uppercase; letter-spacing:.08em; } tr:last-child td { border-bottom:0; }
        input,select,button { font:inherit; } input[type=text],input[type=number],select { width:100%; color:#eff4ff; background:#0b1324; border:1px solid #344a70; border-radius:8px; padding:10px 11px; } input[type=checkbox] { width:17px; height:17px; accent-color:#6f98ff; } button,.button { display:inline-flex; align-items:center; justify-content:center; border:0; border-radius:8px; padding:10px 14px; background:linear-gradient(135deg,#5f8dff,#7162e8); color:#fff; font-weight:700; cursor:pointer; text-decoration:none; } button:hover,.button:hover { filter:brightness(1.1); } .button.secondary,button.secondary { background:#202e49; color:#dce7ff; } .actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:17px; }
        .field { display:grid; gap:7px; margin:0 0 16px; max-width:520px; color:#cbd7eb; font-weight:600; } .notice { background:#143a2c; color:#b5f3d0; border:1px solid #246242; padding:12px 14px; border-radius:9px; margin:0 0 16px; }
        .log-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:0 0 14px; } .log-toolbar .meta { margin:0; } .log-view { background:#080d19; border:1px solid #263755; border-radius:13px; overflow:auto; max-height:calc(100vh - 245px); min-height:420px; font:.78rem/1.48 ui-monospace, SFMono-Regular, Consolas, monospace; } .log-entry { display:grid; grid-template-columns:150px 76px minmax(180px,22vw) minmax(420px,1fr); gap:12px; min-width:900px; padding:9px 13px; border-bottom:1px solid #1d2a42; white-space:pre-wrap; } .log-entry > span { min-width:0; } .log-entry .message { overflow-wrap:anywhere; } .log-entry:last-child { border-bottom:0; } .log-entry .time,.log-entry .category { color:#9fb1ce; } .log-entry .category { overflow-wrap:anywhere; } .log-entry .level { font-weight:700; } .log-entry .level.Warning { color:#ffd27d; } .log-entry .level.Error,.log-entry .level.Critical { color:#ff9da7; } .log-entry .level.Information { color:#92bdff; } .log-entry .level.Debug,.log-entry .level.Trace { color:#a7b5cf; } .log-exception { grid-column:4; min-width:0; color:#ffb0b0; margin:0; white-space:pre-wrap; overflow-wrap:anywhere; }
        .sessions { display:grid; grid-template-columns:clamp(260px,22vw,390px) minmax(0,1fr); gap:15px; min-height:570px; } .session-list,.conversation { min-width:0; background:#111a2e; border:1px solid #263755; border-radius:13px; overflow:hidden; } .session-list { overflow:auto; max-height:calc(100vh - 195px); } .session-item { display:block; width:100%; border:0; border-bottom:1px solid #263755; border-radius:0; padding:14px; text-align:left; background:transparent; color:#dce7ff; } .session-item:hover,.session-item.selected { background:#1c2d4c; filter:none; } .session-id { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:700; } .session-item .meta { margin:5px 0 0; font-size:.78rem; } .conversation { padding:clamp(18px,1.5vw,28px); overflow:auto; max-height:calc(100vh - 195px); } .conversation-empty { display:grid; min-height:450px; place-items:center; color:#aebbd1; text-align:center; } .turn { min-width:0; border-bottom:1px solid #263755; padding:0 0 22px; margin:0 0 22px; } .turn:last-child { border-bottom:0; margin-bottom:0; } .turn-head { display:flex; justify-content:space-between; gap:12px; align-items:center; min-width:0; margin-bottom:14px; } .turn-head h2 { min-width:0; overflow-wrap:anywhere; } .turn-head .meta { margin:0; } .turn-message { min-width:0; border-left:3px solid #5f8dff; background:#0b1324; border-radius:0 8px 8px 0; padding:10px 12px; margin:8px 0; } .turn-message.assistant { border-left-color:#8c5bff; } .turn-message pre { max-width:100%; margin:7px 0 0; color:#dce7ff; font:inherit; white-space:pre-wrap; overflow-wrap:anywhere; } .turn-message p { margin:0; color:#9fb1ce; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; } .turn-error { color:#ffb0b0; border-left-color:#e56d7c; } .turn-status { flex:none; font-size:.74rem; font-weight:750; border-radius:999px; padding:5px 9px; background:#243653; color:#a9c3ff; } .turn-status.completed { color:#8ff0bb; background:#123a2d; } .turn-status.failed { color:#ffb0b0; background:#48242d; }
        code { padding:2px 5px; background:#17243c; border-radius:4px; color:#b9d1ff; }
        @@media(max-width:1200px) { .layout { grid-template-columns:190px minmax(0,1fr); gap:20px; } .sessions { grid-template-columns:minmax(250px,30%) minmax(0,1fr); } }
        @@media(max-width:900px) { .log-entry { grid-template-columns:1fr; gap:4px; min-width:0; } .log-exception { grid-column:auto; } .log-view { max-height:none; } .sessions { grid-template-columns:1fr; } .session-list,.conversation { max-height:none; } .provider-card { grid-template-columns:minmax(180px,.7fr) minmax(0,1.5fr); align-items:start; } .provider-link { grid-column:2; justify-self:start; } }
        @@media(max-width:760px) { .shell { padding:16px; } .layout { grid-template-columns:1fr; } nav { position:static; grid-template-columns:repeat(3,1fr); } nav a { font-size:.82rem; text-align:center; padding:9px 5px; } .topbar { padding-bottom:18px; } .page-heading { display:block; } .page-heading .actions { margin-top:14px; } .dashboard-summary { grid-template-columns:1fr; gap:14px; margin-bottom:26px; } .summary-card,.provider-card { padding:19px; } .provider-card { grid-template-columns:1fr; gap:18px; } .provider-details { grid-template-columns:1fr; gap:18px; } .provider-card .usage-activity { padding:18px 0 0; border:0; border-top:1px solid #263755; } .provider-link { grid-column:auto; } .section-heading { align-items:flex-start; } table { display:block; overflow-x:auto; } .turn-head { align-items:flex-start; flex-wrap:wrap; } }
    </style>
</head>
<body><div class="shell">
    <header class="topbar"><a class="brand" asp-page="/Index"><span class="logo">A</span>AiProxy</a><span class="local">● Lokal administrasjon</span></header>
    @{ var currentPage = ViewContext.RouteData.Values["page"]?.ToString(); }
    <div class="layout"><nav aria-label="Administrasjon">
        <a class="@(currentPage == "/Index" ? "active" : "")" asp-page="/Index">Oversikt</a><a class="@(currentPage == "/Sessions" ? "active" : "")" asp-page="/Sessions">Sesjoner</a><a class="@(currentPage == "/Providers" ? "active" : "")" asp-page="/Providers">Providers</a><a class="@(currentPage == "/Models" ? "active" : "")" asp-page="/Models">Modeller</a><a class="@(currentPage == "/Settings" ? "active" : "")" asp-page="/Settings">Innstillinger</a><a class="@(currentPage == "/M365" ? "active" : "")" asp-page="/M365">M365 Copilot</a><a class="@(currentPage == "/Logs" ? "active" : "")" asp-page="/Logs">Logger</a>
    </nav><main>@RenderBody()</main></div>
</div>
</body>
</html>