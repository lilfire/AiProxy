@page "/admin/m365"
@model M365Model
@{ ViewData["Title"] = "M365"; }
<div class="page-heading"><div><p class="eyebrow">Microsoft-konto</p><h1>M365 Copilot</h1><p class="subtitle">Administrer den lokale token-cachen som brukes av M365-provideren.</p></div><span class="status @(Model.Status.IsSignedIn ? "ok" : "bad")">@(Model.Status.IsSignedIn ? "Innlogget" : "Ikke innlogget")</span></div>
<section class="card" style="margin-bottom:18px"><h2>@(Model.Status.IsSignedIn ? "Konto tilkoblet" : "Ingen konto tilkoblet")</h2><p class="meta">@(Model.Status.Username ?? "Logg inn med Microsoft-kontoen som har tilgang til M365 Copilot.")</p></section>
<section class="card" style="margin-bottom:18px"><h2>M365-bildeopplasting</h2><p class="meta">@Model.BrowserStatus.Message</p><div class="actions"><form method="post"><button type="submit" asp-page-handler="ConnectImageUpload">Koble til bildeopplasting</button></form>@if (Model.BrowserStatus.IsConfigured) { <form method="post"><button type="submit" class="button secondary" asp-page-handler="SignOutImageUpload">Fjern bildeprofil</button></form> }</div></section>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="notice">@Model.Message</p> }
<form method="post"><div class="field"><label><input asp-for="Settings.EnableInteractiveLogin" /> Tillat interaktiv M365-innlogging</label></div><div class="field"><label asp-for="Settings.Locale">Språk</label><input asp-for="Settings.Locale" /></div><div class="field"><label asp-for="Settings.TimeZone">Tidssone</label><input asp-for="Settings.TimeZone" /></div><div class="field"><label asp-for="Settings.WorkspaceDirectory">Prosjektmappe</label><input asp-for="Settings.WorkspaceDirectory" placeholder="Tom = tjenestens prosjektmappe" /><p class="meta">Filer herfra legges automatisk ved M365-forespørsler. Hemmelige filer, binærfiler og build-mapper utelates.</p></div><div class="field"><label><input asp-for="Settings.IncludeWorkspaceFiles" /> Legg ved prosjektfiler automatisk</label></div><div class="field"><label><input asp-for="Settings.EnableWorkspaceWrites" /> Skriv godkjente filendringer tilbake</label><p class="meta">Endringer erstatter filen direkte; det opprettes ikke .bak-filer.</p></div><div class="actions"><button type="submit" asp-page-handler="Save">Lagre innstillinger</button><button type="submit" asp-page-handler="SignIn">Logg inn</button>@if (Model.Status.IsSignedIn) { <button type="submit" class="button secondary" asp-page-handler="SignOut">Logg ut</button> }</div></form>
<p class="subtitle">De øvrige providerne innlogges i sine respektive CLI-er. Gå til <a class="card-link" asp-page="/Providers">Providers</a> for å se om CLI-en er tilgjengelig.</p>
